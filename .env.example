# Required - PostgreSQL
# Runtime Prisma connection. Use the pooled connection URL when your provider offers one.
POSTGRES_PRISMA_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Direct Prisma migration connection. Use the non-pooled/direct URL when available.
POSTGRES_URL_NON_POOLING=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Required - Personal defaults
# Default currency pre-selected when creating a new group. Other currencies still work.
DEFAULT_CURRENCY_CODE=INR

# Optional - Application URL
# Public URL this instance is reachable at. Defaults to http://localhost:3000
# locally, or https://$VERCEL_URL on Vercel when BASE_URL is unset.
# BASE_URL=https://your-spliit-preview.vercel.app

# Optional - Receipt Storage
# Attach images to expenses (requires S3 storage):
# ENABLE_EXPENSE_DOCUMENTS=true
# S3_UPLOAD_KEY=
# S3_UPLOAD_SECRET=
# S3_UPLOAD_BUCKET=
# S3_UPLOAD_REGION=
# S3_UPLOAD_ENDPOINT=       # only needed for non-AWS S3 providers

# Optional - AI
# Create expenses by scanning receipts (requires OpenAI and expense documents):
# ENABLE_RECEIPT_EXTRACT=true
# OPENAI_API_KEY=

# Auto-suggest the expense category from its title (requires OpenAI):
# ENABLE_CATEGORY_EXTRACT=true
# OPENAI_API_KEY=

# OpenAI options for the receipt and category features (see the README).
# OPENAI_BASE_URL=          # OpenAI-compatible endpoint; defaults to OpenAI
# OPENAI_MODEL_RECEIPT_EXTRACT=gpt-5-nano
# OPENAI_MODEL_CATEGORY_EXTRACT=gpt-5-nano

# Optional - Analytics
# Analytics is disabled unless a provider is selected. See the README.
# ANALYTICS_PROVIDER=console
# ANALYTICS_PROVIDER=plausible
# PLAUSIBLE_DOMAIN=your-domain.com
# PLAUSIBLE_HOST=https://plausible.your-domain.com
# PLAUSIBLE_SCRIPT_URL=/js/script.manual.js
# PLAUSIBLE_API_URL=/proxy/api/event
